# 复制到AutoDL项目的.cache/wandb/network.env；不包含API Key。
export WANDB_HTTP_PROXY=http://127.0.0.1:17890
export WANDB_HTTPS_PROXY=http://127.0.0.1:17890
LLM_WANDB_BYPASS="${NO_PROXY:-${no_proxy:-}}"
for LLM_WANDB_LOCAL in 127.0.0.1 localhost ::1; do
  case ",$LLM_WANDB_BYPASS," in
    *",$LLM_WANDB_LOCAL,"*) ;;
    *) LLM_WANDB_BYPASS="$LLM_WANDB_LOCAL${LLM_WANDB_BYPASS:+,$LLM_WANDB_BYPASS}" ;;
  esac
done
export NO_PROXY="$LLM_WANDB_BYPASS"
export no_proxy="$NO_PROXY"
unset LLM_WANDB_BYPASS LLM_WANDB_LOCAL
