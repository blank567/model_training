{
  "data_manifest": "artifacts/pretrain/wikipedia/manifest.json",
  "output_dir": "runs/pretrain_100m_probe20",
  "model": {
    "vocab_size": 32000, "dim": 768, "n_layers": 12, "n_heads": 12,
    "n_kv_heads": 4, "ffn_dim": 2048, "max_seq_len": 1024,
    "rope_theta": 10000.0, "dropout": 0.1,
    "tie_embeddings": true, "activation_checkpointing": true
