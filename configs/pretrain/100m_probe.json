    "warmup_steps": 2, "weight_decay": 0.1, "max_grad_norm": 1.0,
    "eval_interval": 20, "eval_batches": 1, "save_interval": 20,
    "log_interval": 1, "tensorboard": true,
    "wandb": true, "wandb_project": "bilingual-training-lab", "wandb_mode": "online",
    "wandb_run_name": "pretrain-100m-probe20"
  },
  "budget": {
    "hourly_rate_cny": 3.03, "run_limit_cny": 2, "project_limit_cny": 500,
    "reserve_cny": 100, "max_runtime_seconds": 600,
    "ledger_path": "runs/budget_ledger.json"
  }
}
