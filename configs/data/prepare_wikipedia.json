{
  "project_root": "../..",
  "kind": "pretrain",
  "inputs": ["artifacts/raw/wikipedia/records.jsonl"],
  "output_dir": "artifacts/pretrain/wikipedia",
  "max_docs": 20000,
  "max_bytes": 100000000,
  "max_tokens": 30000000,
  "max_tokens_per_split_per_language": {"train": 14000000, "validation": 400000, "test": 400000},
  "seed": 42,
  "split_fractions": {"train": 0.98, "validation": 0.01, "test": 0.01},
  "tokenizer": {"vocab_size": 32000, "min_frequency": 2},
  "quality": {"min_chars": 80, "max_chars": 100000, "max_character_fraction": 0.5, "min_unique_line_ratio": 0.5},
  "require_all_streams": true,
  "note": "This is a bounded first data shard, not a claim of enough data for a fully trained 100M model. Training can repeat it; report repeated versus unique tokens separately."
}
